NO_SYSTEMD = os.environ.get("NMSS_SPIKE_NO_SYSTEMD") == "1"

# NMVpnServiceState and NMVpnPluginFailure (nm-vpn-dbus-interface.h)
ST_INIT, ST_STARTING, ST_STARTED, ST_STOPPING, ST_STOPPED = 1, 3, 4, 5, 6
STATE_NAMES = {1: "INIT", 3: "STARTING", 4: "STARTED", 5: "STOPPING", 6: "STOPPED"}
FAIL_LOGIN, FAIL_CONNECT, FAIL_BAD_IP = 0, 1, 2
RECONNECT_MODES = ("identical", "nbns", "nbns2", "perturb", "invisible", "relink-wait",
                   "giveup", "giveup-stopped", "giveup-config", "giveup-linklost")
AC_STATES = {0: "unknown", 1: "activating", 2: "activated", 3: "deactivating", 4: "deactivated"}

