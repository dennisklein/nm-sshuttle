[Unit]
Description=sshuttle tunnel for nm-sshuttle
Documentation=https://github.com/dennisklein/nm-sshuttle
# No BindsTo= or PartOf= on nm-sshuttle.service: the plugin must see its own
# SIGTERM before the tunnel goes, so that it gives up in order (design §4.7).
StopWhenUnneeded=no

[Service]
Type=notify
NotifyAccess=main
ExecStartPre=@LIBEXECDIR@/nm-sshuttle sweep
# Reads /run/nm-sshuttle/tunnel.json (written by the plugin) and execs sshuttle.
ExecStart=@LIBEXECDIR@/nm-sshuttle exec-tunnel
# Required, not a safety net: the stop can kill sshuttle's own nft cleanup.
ExecStopPost=@LIBEXECDIR@/nm-sshuttle sweep
Restart=no
# The plugin gives an attempt 45 s and stops the unit itself; only its one
# retry after an unlock waits up to 110 s for the agent's prompt (design §4.3).
TimeoutStartSec=120
TimeoutStopSec=15
