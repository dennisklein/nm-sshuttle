#!/bin/sh
# SPDX-License-Identifier: MIT
#
# program= of the VPN .name file. NetworkManager spawns this inside its own
# cgroup and SELinux domain and then waits for the plugin's bus name. All it
# does is ask the bus to activate the plugin, which starts
# nm-sshuttle.service through systemd (design §4.1).
exec busctl --system call org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus StartServiceByName su org.freedesktop.NetworkManager.sshuttle 0
