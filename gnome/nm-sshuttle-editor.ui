<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MIT -->
<!--
  The form of the editor (design: docs/later/gnome-editor.md). GNOME Settings
  removes the colon from a label that ends in one and aligns it to the right,
  so the labels keep both.
-->
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkGrid" id="form">
    <property name="column-spacing">12</property>
    <property name="row-spacing">2</property>
    <property name="margin-top">12</property>
    <property name="margin-bottom">12</property>
    <property name="margin-start">12</property>
    <property name="margin-end">12</property>
    <child>
      <object class="GtkLabel" id="note">
        <property name="label" translatable="yes">Before you connect, switch on “Use this connection only for resources on its network” on the IPv4 and IPv6 tabs.</property>
        <property name="halign">start</property>
        <property name="xalign">0</property>
        <property name="wrap">True</property>
        <property name="max-width-chars">64</property>
        <layout>
          <property name="column">0</property>
          <property name="row">0</property>
          <property name="column-span">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="lbl_remote">
        <property name="label" translatable="yes">SSH destination:</property>
        <property name="valign">center</property>
        <property name="xalign">0</property>
        <layout>
          <property name="column">0</property>
          <property name="row">1</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkEntry" id="remote">
        <property name="hexpand">True</property>
        <property name="width-chars">36</property>
        <accessibility>
          <relation name="labelled-by">lbl_remote</relation>
          <relation name="described-by">hint_remote</relation>
        </accessibility>
        <layout>
          <property name="column">1</property>
          <property name="row">1</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="hint_remote">
        <property name="label" translatable="yes">An alias from ~/.ssh/config, such as corp, or user@host</property>
        <property name="xalign">0</property>
        <property name="wrap">True</property>
        <property name="max-width-chars">64</property>
        <style>
          <class name="dim-label"/>
          <class name="caption"/>
        </style>
        <layout>
          <property name="column">1</property>
          <property name="row">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="lbl_subnets">
        <property name="label" translatable="yes">Networks:</property>
        <property name="valign">center</property>
        <property name="xalign">0</property>
        <layout>
          <property name="column">0</property>
          <property name="row">3</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkEntry" id="subnets">
        <property name="hexpand">True</property>
        <property name="width-chars">36</property>
        <accessibility>
          <relation name="labelled-by">lbl_subnets</relation>
          <relation name="described-by">hint_subnets</relation>
        </accessibility>
        <layout>
          <property name="column">1</property>
          <property name="row">3</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="hint_subnets">
        <property name="label" translatable="yes">Networks to send through the tunnel, such as 10.0.0.0/8 2001:db8::/32</property>
        <property name="xalign">0</property>
        <property name="wrap">True</property>
        <property name="max-width-chars">64</property>
        <style>
          <class name="dim-label"/>
          <class name="caption"/>
        </style>
        <layout>
          <property name="column">1</property>
          <property name="row">4</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="lbl_exclude">
        <property name="label" translatable="yes">Exclude:</property>
        <property name="valign">center</property>
        <property name="xalign">0</property>
        <layout>
          <property name="column">0</property>
          <property name="row">5</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkEntry" id="exclude">
        <property name="hexpand">True</property>
        <property name="width-chars">36</property>
        <accessibility>
          <relation name="labelled-by">lbl_exclude</relation>
          <relation name="described-by">hint_exclude</relation>
        </accessibility>
        <layout>
          <property name="column">1</property>
          <property name="row">5</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="hint_exclude">
        <property name="label" translatable="yes">Networks inside those that stay outside the tunnel (optional)</property>
        <property name="xalign">0</property>
        <property name="wrap">True</property>
        <property name="max-width-chars">64</property>
        <style>
          <class name="dim-label"/>
          <class name="caption"/>
        </style>
        <layout>
          <property name="column">1</property>
          <property name="row">6</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="lbl_dns">
        <property name="label" translatable="yes">DNS:</property>
        <property name="valign">center</property>
        <property name="xalign">0</property>
        <layout>
          <property name="column">0</property>
          <property name="row">7</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkDropDown" id="dns">
        <property name="hexpand">True</property>
        <property name="model">
          <object class="GtkStringList">
            <items>
              <item translatable="yes">Leave unchanged</item>
              <item translatable="yes">Only for the domains below</item>
              <item translatable="yes">All lookups</item>
            </items>
          </object>
        </property>
        <accessibility>
          <relation name="labelled-by">lbl_dns</relation>
          <relation name="described-by">hint_dns</relation>
        </accessibility>
        <layout>
          <property name="column">1</property>
          <property name="row">7</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="hint_dns">
        <property name="label" translatable="yes">Where lookups go while the tunnel is up</property>
        <property name="xalign">0</property>
        <property name="wrap">True</property>
        <property name="max-width-chars">64</property>
        <style>
          <class name="dim-label"/>
          <class name="caption"/>
        </style>
        <layout>
          <property name="column">1</property>
          <property name="row">8</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="lbl_dns_servers">
        <property name="label" translatable="yes">DNS servers:</property>
        <property name="valign">center</property>
        <property name="xalign">0</property>
        <layout>
          <property name="column">0</property>
          <property name="row">9</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkEntry" id="dns_servers">
        <property name="hexpand">True</property>
        <property name="width-chars">36</property>
        <accessibility>
          <relation name="labelled-by">lbl_dns_servers</relation>
          <relation name="described-by">hint_dns_servers</relation>
        </accessibility>
        <layout>
          <property name="column">1</property>
          <property name="row">9</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="hint_dns_servers">
        <property name="label" translatable="yes">IPv4 addresses reachable through the tunnel, such as 10.1.0.53</property>
        <property name="xalign">0</property>
        <property name="wrap">True</property>
        <property name="max-width-chars">64</property>
        <style>
          <class name="dim-label"/>
          <class name="caption"/>
        </style>
        <layout>
          <property name="column">1</property>
          <property name="row">10</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="lbl_dns_domains">
        <property name="label" translatable="yes">DNS domains:</property>
        <property name="valign">center</property>
        <property name="xalign">0</property>
        <layout>
          <property name="column">0</property>
          <property name="row">11</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkEntry" id="dns_domains">
        <property name="hexpand">True</property>
        <property name="width-chars">36</property>
        <accessibility>
          <relation name="labelled-by">lbl_dns_domains</relation>
          <relation name="described-by">hint_dns_domains</relation>
        </accessibility>
        <layout>
          <property name="column">1</property>
          <property name="row">11</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="hint_dns_domains">
        <property name="label" translatable="yes">Names that go to those servers, such as corp.example</property>
        <property name="xalign">0</property>
        <property name="wrap">True</property>
        <property name="max-width-chars">64</property>
        <style>
          <class name="dim-label"/>
          <class name="caption"/>
        </style>
        <layout>
          <property name="column">1</property>
          <property name="row">12</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkExpander" id="advanced">
        <property name="label" translatable="yes">Advanced</property>
        <property name="margin-top">6</property>
        <layout>
          <property name="column">0</property>
          <property name="row">13</property>
          <property name="column-span">2</property>
        </layout>
      </object>
    </child>
    <child>
      <!-- Not the expander's own child: that one is out of the widget tree
           while collapsed, and Settings would not find its labels. -->
      <object class="GtkRevealer" id="advanced_rows">
        <property name="reveal-child" bind-source="advanced" bind-property="expanded" bind-flags="sync-create"/>
        <property name="child">
          <object class="GtkGrid">
            <property name="column-spacing">12</property>
            <property name="row-spacing">2</property>
            <property name="margin-top">6</property>
            <child>
              <object class="GtkLabel" id="lbl_gateway">
                <property name="label" translatable="yes">First hop:</property>
                <property name="valign">center</property>
                <property name="xalign">0</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="gateway">
                <property name="hexpand">True</property>
                <property name="width-chars">36</property>
                <accessibility>
                  <relation name="labelled-by">lbl_gateway</relation>
                  <relation name="described-by">hint_gateway</relation>
                </accessibility>
                <layout>
                  <property name="column">1</property>
                  <property name="row">1</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="hint_gateway">
                <property name="label" translatable="yes">An IP address. Leave empty to take it from ssh -G; set it when the host is reached through a ProxyCommand</property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
                <property name="max-width-chars">64</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
                <layout>
                  <property name="column">1</property>
                  <property name="row">2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_probe">
                <property name="label" translatable="yes">Probe:</property>
                <property name="valign">center</property>
                <property name="xalign">0</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkEntry" id="probe">
                <property name="hexpand">True</property>
                <property name="width-chars">36</property>
                <accessibility>
                  <relation name="labelled-by">lbl_probe</relation>
                  <relation name="described-by">hint_probe</relation>
                </accessibility>
                <layout>
                  <property name="column">1</property>
                  <property name="row">3</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="hint_probe">
                <property name="label" translatable="yes">ADDRESS:PORT or [IPV6]:PORT of a service inside the tunnel that sends first, such as ssh (optional)</property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
                <property name="max-width-chars">64</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
                <layout>
                  <property name="column">1</property>
                  <property name="row">4</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_method">
                <property name="label" translatable="yes">Method:</property>
                <property name="valign">center</property>
                <property name="xalign">0</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">5</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkDropDown" id="method">
                <property name="hexpand">True</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>nft</item>
                      <item>nat</item>
                      <item>tproxy</item>
                    </items>
                  </object>
                </property>
                <accessibility>
                  <relation name="labelled-by">lbl_method</relation>
                  <relation name="described-by">hint_method</relation>
                </accessibility>
                <layout>
                  <property name="column">1</property>
                  <property name="row">5</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="hint_method">
                <property name="label" translatable="yes">How traffic is captured. nft is the default; tproxy also carries UDP</property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
                <property name="max-width-chars">64</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
                <layout>
                  <property name="column">1</property>
                  <property name="row">6</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="lbl_fail_closed">
                <property name="label" translatable="yes">Block traffic while down:</property>
                <property name="valign">center</property>
                <property name="xalign">0</property>
                <layout>
                  <property name="column">0</property>
                  <property name="row">7</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkSwitch" id="fail_closed">
                <property name="halign">start</property>
                <property name="valign">center</property>
                <property name="active">True</property>
                <accessibility>
                  <relation name="labelled-by">lbl_fail_closed</relation>
                  <relation name="described-by">hint_fail_closed</relation>
                </accessibility>
                <layout>
                  <property name="column">1</property>
                  <property name="row">7</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="hint_fail_closed">
                <property name="label" translatable="yes">Refuse traffic to the tunnelled networks while the tunnel is down</property>
                <property name="xalign">0</property>
                <property name="wrap">True</property>
                <property name="max-width-chars">64</property>
                <style>
                  <class name="dim-label"/>
                  <class name="caption"/>
                </style>
                <layout>
                  <property name="column">1</property>
                  <property name="row">8</property>
                </layout>
              </object>
            </child>
          </object>
        </property>
        <layout>
          <property name="column">0</property>
          <property name="row">14</property>
          <property name="column-span">2</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="lbl_local_user">
        <property name="label" translatable="yes">Local user:</property>
        <property name="valign">center</property>
        <property name="xalign">0</property>
        <layout>
          <property name="column">0</property>
          <property name="row">15</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="local_user">
        <property name="halign">start</property>
        <property name="xalign">0</property>
        <property name="selectable">True</property>
        <accessibility>
          <relation name="labelled-by">lbl_local_user</relation>
          <relation name="described-by">hint_local_user</relation>
        </accessibility>
        <layout>
          <property name="column">1</property>
          <property name="row">15</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="hint_local_user">
        <property name="label" translatable="yes">Whose ssh keys and agent the tunnel uses. The profile stays private to this user</property>
        <property name="xalign">0</property>
        <property name="wrap">True</property>
        <property name="max-width-chars">64</property>
        <style>
          <class name="dim-label"/>
          <class name="caption"/>
        </style>
        <layout>
          <property name="column">1</property>
          <property name="row">16</property>
        </layout>
      </object>
    </child>
  </object>
  <object class="GtkSizeGroup">
    <property name="mode">horizontal</property>
    <widgets>
      <widget name="lbl_remote"/>
      <widget name="lbl_subnets"/>
      <widget name="lbl_exclude"/>
      <widget name="lbl_dns"/>
      <widget name="lbl_dns_servers"/>
      <widget name="lbl_dns_domains"/>
      <widget name="lbl_gateway"/>
      <widget name="lbl_probe"/>
      <widget name="lbl_method"/>
      <widget name="lbl_fail_closed"/>
      <widget name="lbl_local_user"/>
    </widgets>
  </object>
</interface>
