{
  "comment": [
    "Cases for the profile rules of design 4.2. Two programs read this file: the",
    "plugin's profile.parse (tests/test_profile_cases.py) and the GNOME editor's",
    "validator in C (gnome/tests/test-validate.c). A rule changed on one side",
    "fails the other's test run.",
    "",
    "A case starts from \"base\" and changes it: \"data\" sets vpn.data keys (null",
    "removes one), \"permissions\", \"persistent\" and \"ipv4_method\" replace the",
    "connection fields. \"error\" names the first wrong field (the start of",
    "profile.parse's message); a case without it must be accepted.",
    "\"plugin_only\" marks a rule that needs the user database, which the editor",
    "does not read."
  ],
  "base": {
    "permissions": ["user:alice:"],
    "persistent": true,
    "ipv4_method": "auto",
    "data": {
      "remote": "corp",
      "local-user": "alice",
      "subnets": "10.0.0.0/8",
      "dns": "split",
      "dns-servers": "10.1.0.53",
      "dns-domains": "~corp.example"
    }
  },
  "cases": [
    {"name": "the base profile"},
    {"name": "remote with user and port", "data": {"remote": "bob@gw.example:2222"}},
    {"name": "remote as a bracketed address", "data": {"remote": "[2001:db8::1]"}},
    {"name": "remote that is empty", "data": {"remote": ""}, "error": "remote"},
    {"name": "remote that is missing", "data": {"remote": null}, "error": "remote"},
    {"name": "remote that looks like an option", "data": {"remote": "-oProxyCommand=x"}, "error": "remote"},
    {"name": "remote with a shell command", "data": {"remote": "corp; rm -rf /"}, "error": "remote"},
    {"name": "remote with a space", "data": {"remote": "corp example"}, "error": "remote"},

    {"name": "local user with a space", "data": {"local-user": "alice x"}, "error": "local-user"},
    {"name": "local user that looks like an option", "data": {"local-user": "-alice"}, "error": "local-user"},
    {"name": "local user that is empty", "data": {"local-user": ""}, "error": "local-user"},
    {"name": "local user that does not exist", "data": {"local-user": "mallory"}, "error": "local-user", "plugin_only": true},
    {"name": "local user that is root", "data": {"local-user": "root"}, "error": "local-user", "plugin_only": true},

    {"name": "permissions without the trailing colon", "permissions": ["user:alice"]},
    {"name": "permissions that are empty", "permissions": [], "error": "connection.permissions"},
    {"name": "permissions for two users", "permissions": ["user:alice:", "user:bob:"], "error": "connection.permissions"},
    {"name": "permissions for another user", "permissions": ["user:bob:"], "error": "connection.permissions"},
    {"name": "vpn.persistent off", "persistent": false, "error": "vpn.persistent"},
    {"name": "ipv4.method unset", "ipv4_method": null},
    {"name": "ipv4.method manual", "ipv4_method": "manual", "error": "ipv4.method"},
    {"name": "ipv4.method disabled", "ipv4_method": "disabled", "error": "ipv4.method"},

    {"name": "subnets separated by commas and spaces", "data": {"subnets": "10.0.0.0/8, 172.20.0.0/16 192.168.0.0/24"}},
    {"name": "subnets with host bits set", "data": {"subnets": "10.1.2.3/8"}},
    {"name": "subnets of one host", "data": {"subnets": "10.0.0.1/32"}},
    {"name": "subnets of everything", "data": {"subnets": "0.0.0.0/0"}},
    {"name": "subnets that are a bare address", "data": {"subnets": "10.0.0.1"}},
    {"name": "subnets with a netmask", "data": {"subnets": "10.0.0.0/255.0.0.0"}},
    {"name": "subnets with a hostmask", "data": {"subnets": "10.0.0.0/0.255.255.255"}},
    {"name": "subnets that are empty", "data": {"subnets": ""}, "error": "subnets"},
    {"name": "subnets that are missing", "data": {"subnets": null}, "error": "subnets"},
    {"name": "subnets with a prefix of 33", "data": {"subnets": "10.0.0.0/33"}, "error": "subnets"},
    {"name": "subnets with an octet of 256", "data": {"subnets": "10.0.0.256/8"}, "error": "subnets"},
    {"name": "subnets with a mask that has holes", "data": {"subnets": "1.2.3.4/255.0.255.0"}, "error": "subnets"},
    {"name": "subnets with an empty prefix", "data": {"subnets": "10.0.0.0/"}, "error": "subnets"},
    {"name": "subnets with one bad network among good ones", "data": {"subnets": "10.0.0.0/8 nonsense"}, "error": "subnets"},
    {"name": "subnets that are IPv6", "data": {"subnets": "fd00::/8"}},
    {"name": "subnets of both families", "data": {"subnets": "10.0.0.0/8, 2001:db8:10::/48 2001:DB8:11::/48"}},
    {"name": "subnets of one IPv6 host", "data": {"subnets": "2001:db8::1/128"}},
    {"name": "subnets that are a bare IPv6 address", "data": {"subnets": "2001:db8::1"}},
    {"name": "subnets with an IPv6 prefix of 129", "data": {"subnets": "2001:db8::/129"}, "error": "subnets"},
    {"name": "subnets with an IPv6 address that is too long", "data": {"subnets": "2001:db8::1::2/64"}, "error": "subnets"},
    {"name": "exclude inside the subnets", "data": {"exclude": "10.0.5.0/24, 10.0.6.0/24"}},
    {"name": "exclude that is nonsense", "data": {"exclude": "nonsense"}, "error": "exclude"},
    {"name": "exclude that is IPv6", "data": {"exclude": "fd00::/8"}},
    {"name": "exclude with an IPv6 prefix of 129", "data": {"exclude": "2001:db8::/129"}, "error": "exclude"},

    {"name": "dns none without servers", "data": {"dns": "none", "dns-servers": null, "dns-domains": null}},
    {"name": "dns not set", "data": {"dns": null, "dns-servers": null, "dns-domains": null}},
    {"name": "dns all with servers only", "data": {"dns": "all", "dns-domains": null}},
    {"name": "dns that is empty", "data": {"dns": ""}, "error": "dns"},
    {"name": "dns that is unknown", "data": {"dns": "maybe"}, "error": "dns"},
    {"name": "dns that is capitalised", "data": {"dns": "Split"}, "error": "dns"},
    {"name": "dns servers separated by commas", "data": {"dns-servers": "10.1.0.53,10.1.0.54"}},
    {"name": "dns split without servers", "data": {"dns-servers": null}, "error": "dns-servers"},
    {"name": "dns all without servers", "data": {"dns": "all", "dns-servers": ""}, "error": "dns-servers"},
    {"name": "dns server out of range", "data": {"dns-servers": "10.1.0.300"}, "error": "dns-servers"},
    {"name": "dns server that is a network", "data": {"dns-servers": "10.1.0.0/24"}, "error": "dns-servers"},
    {"name": "dns server that is IPv6", "data": {"dns-servers": "fd00::53"}, "error": "dns-servers"},
    {"name": "dns domains of several kinds", "data": {"dns-domains": "corp.example ~lab.example. ~. other"}},
    {"name": "dns split without domains", "data": {"dns-domains": null}, "error": "dns-domains"},
    {"name": "dns split with empty domains", "data": {"dns-domains": ""}, "error": "dns-domains"},
    {"name": "dns domain with a slash", "data": {"dns-domains": "corp/x"}, "error": "dns-domains"},
    {"name": "dns domain with an empty label", "data": {"dns-domains": "corp..example"}, "error": "dns-domains"},

    {"name": "method nat", "data": {"method": "nat"}},
    {"name": "method nft", "data": {"method": "nft"}},
    {"name": "method tproxy before it exists", "data": {"method": "tproxy"}, "error": "method"},
    {"name": "method that is capitalised", "data": {"method": "NFT"}, "error": "method"},
    {"name": "method that is empty", "data": {"method": ""}, "error": "method"},

    {"name": "gateway", "data": {"gateway": "203.0.113.7"}},
    {"name": "gateway that is empty", "data": {"gateway": ""}},
    {"name": "gateway that is a name", "data": {"gateway": "corp.example"}, "error": "gateway"},
    {"name": "gateway out of range", "data": {"gateway": "203.0.113.256"}, "error": "gateway"},
    {"name": "gateway that is IPv6", "data": {"gateway": "2001:db8::1"}},
    {"name": "gateway that is a bad IPv6 address", "data": {"gateway": "2001:db8::g"}, "error": "gateway"},

    {"name": "probe", "data": {"probe": "10.1.0.10:22"}},
    {"name": "probe that is empty", "data": {"probe": ""}},
    {"name": "probe that is IPv6", "data": {"probe": "[2001:DB8::10]:22"}},
    {"name": "probe that is IPv6 without brackets", "data": {"probe": "2001:db8::10:22"}, "error": "probe"},
    {"name": "probe that is IPv4 in brackets", "data": {"probe": "[10.1.0.10]:22"}, "error": "probe"},
    {"name": "probe that is IPv6 with port 0", "data": {"probe": "[2001:db8::10]:0"}, "error": "probe"},
    {"name": "probe without a port", "data": {"probe": "10.1.0.10"}, "error": "probe"},
    {"name": "probe with port 0", "data": {"probe": "10.1.0.10:0"}, "error": "probe"},
    {"name": "probe with port 65536", "data": {"probe": "10.1.0.10:65536"}, "error": "probe"},
    {"name": "probe with port 99999", "data": {"probe": "10.1.0.10:99999"}, "error": "probe"},
    {"name": "probe with a name", "data": {"probe": "corp:22"}, "error": "probe"},

    {"name": "fail-closed yes", "data": {"fail-closed": "yes"}},
    {"name": "fail-closed no", "data": {"fail-closed": "no"}},
    {"name": "fail-closed true", "data": {"fail-closed": "true"}},
    {"name": "fail-closed 0", "data": {"fail-closed": "0"}},
    {"name": "fail-closed that is empty", "data": {"fail-closed": ""}},
    {"name": "fail-closed perhaps", "data": {"fail-closed": "perhaps"}, "error": "fail-closed"},
    {"name": "fail-closed capitalised", "data": {"fail-closed": "YES"}, "error": "fail-closed"},

    {"name": "a key nobody knows is ignored", "data": {"ssh-options": "-oFoo"}}
  ]
}
