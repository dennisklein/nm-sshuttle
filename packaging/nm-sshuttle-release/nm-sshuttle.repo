[nm-sshuttle]
name=nm-sshuttle - Fedora $releasever - $basearch
baseurl=https://dennisklein.github.io/nm-sshuttle/rpm/fedora/$releasever/$basearch/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-nm-sshuttle
metadata_expire=6h

[nm-sshuttle-source]
name=nm-sshuttle - Fedora - Source
baseurl=https://dennisklein.github.io/nm-sshuttle/rpm/fedora/source/
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-nm-sshuttle
metadata_expire=6h
